[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/rules_menu.gd" id="1_rules"]
[ext_resource type="Script" path="res://scripts/ui/menu_background.gd" id="2_bg"]
[ext_resource type="Theme" path="res://assets/themes/menu_theme.tres" id="3_theme"]
[ext_resource type="Script" path="res://scripts/ui/back_arrow.gd" id="9_back"]
[ext_resource type="Script" path="res://scripts/ui/settings_button.gd" id="11_settings"]

[node name="Rules" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_rules")

[node name="Background" type="Control" parent="."]
mouse_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_bg")

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 72
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Layout" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="SearchEdit" type="LineEdit" parent="Content/Layout"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Search the rules (put words in \"quotes\" for an exact phrase)"
clear_button_enabled = true

[node name="RulesScroll" type="ScrollContainer" parent="Content/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="RulesPadding" type="MarginContainer" parent="Content/Layout/RulesScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 8

[node name="RuleList" type="VBoxContainer" parent="Content/Layout/RulesScroll/RulesPadding"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 32

[node name="NoResultsLabel" type="Label" parent="Content/Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.62, 0.64, 0.74, 1)
text = "No rules match this search."
horizontal_alignment = 1
vertical_alignment = 1

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 1
offset_left = 6.0
offset_top = 6.0
offset_right = 58.0
offset_bottom = 58.0
script = ExtResource("9_back")

[node name="SettingsButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = -58.0
offset_right = 58.0
offset_bottom = -6.0
grow_vertical = 0
script = ExtResource("11_settings")
