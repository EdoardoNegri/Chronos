[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_menu.gd" id="1_settings"]
[ext_resource type="Script" path="res://scripts/ui/menu_background.gd" id="2_bg"]
[ext_resource type="Theme" path="res://assets/themes/menu_theme.tres" id="3_theme"]
[ext_resource type="Script" path="res://scripts/ui/back_arrow.gd" id="9_back"]

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_settings")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_bg")

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 72
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Layout" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="OptionsPanel" type="PanelContainer" parent="Content/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"Card"

[node name="OptionsMargin" type="MarginContainer" parent="Content/Layout/OptionsPanel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Options" type="VBoxContainer" parent="Content/Layout/OptionsPanel/OptionsMargin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="DisplayLabel" type="Label" parent="Content/Layout/OptionsPanel/OptionsMargin/Options"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
text = "Display"

[node name="FullscreenCheck" type="CheckButton" parent="Content/Layout/OptionsPanel/OptionsMargin/Options"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Fullscreen"

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 1
offset_left = 6.0
offset_top = 6.0
offset_right = 58.0
offset_bottom = 58.0
script = ExtResource("9_back")
