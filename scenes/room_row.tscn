[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/room_row.gd" id="1_row"]

[node name="RoomRow" type="PanelContainer"]
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
theme_type_variation = &"RoomRow"
script = ExtResource("1_row")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Info" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="RoomName" type="Label" parent="Layout/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.9, 0.78, 1)
theme_override_font_sizes/font_size = 24
text = "Room name"
text_overrun_behavior = 3

[node name="HostName" type="Label" parent="Layout/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.64, 0.74, 1)
theme_override_font_sizes/font_size = 16
text = "Hosted by"

[node name="Players" type="Label" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 22
text = "1 / 2"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Status" type="Label" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Open"
horizontal_alignment = 1
vertical_alignment = 1

[node name="JoinButton" type="Button" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Join"

[connection signal="pressed" from="Layout/JoinButton" to="." method="_on_join_button_pressed"]
