[node name="HostGap" type="Control" parent="Content/Layout/Toolbar/HostField"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="HostButton" type="Button" parent="Content/Layout/Toolbar/HostField"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
