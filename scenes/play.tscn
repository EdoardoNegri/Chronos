[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/play_menu.gd" id="1_play"]
[ext_resource type="Script" path="res://scripts/ui/menu_background.gd" id="2_bg"]
[ext_resource type="Theme" path="res://assets/themes/menu_theme.tres" id="3_theme"]
[ext_resource type="PackedScene" path="res://scenes/room_row.tscn" id="4_row"]

[node name="Play" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_play")
room_row_scene = ExtResource("4_row")

[node name="Background" type="Control" parent="."]
mouse_filter = 2
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_bg")

[node name="Content" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 32

[node name="Layout" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Content/Layout"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Content/Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "< Back"

[node name="Title" type="Label" parent="Content/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.8, 0.45, 1)
theme_override_colors/font_shadow_color = Color(0.86, 0.7, 0.36, 0.35)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 0
theme_override_constants/shadow_outline_size = 10
theme_override_font_sizes/font_size = 48
text = "PLAY"
horizontal_alignment = 1
vertical_alignment = 1

[node name="HeaderBalance" type="Control" parent="Content/Layout/Header"]
custom_minimum_size = Vector2(140, 0)
layout_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="Content/Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SearchEdit" type="LineEdit" parent="Content/Layout/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Search rooms by name or host..."
clear_button_enabled = true

[node name="RefreshButton" type="Button" parent="Content/Layout/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Refresh"

[node name="HostButton" type="Button" parent="Content/Layout/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Host Room"

[node name="ListPanel" type="PanelContainer" parent="Content/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"Card"

[node name="ListMargin" type="MarginContainer" parent="Content/Layout/ListPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Scroll" type="ScrollContainer" parent="Content/Layout/ListPanel/ListMargin"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="RoomList" type="VBoxContainer" parent="Content/Layout/ListPanel/ListMargin/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="EmptyLabel" type="Label" parent="Content/Layout/ListPanel/ListMargin"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.64, 0.74, 1)
theme_override_font_sizes/font_size = 22
text = "No rooms online yet. Host one!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Status" type="Label" parent="Content/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.64, 0.74, 1)
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="HostOverlay" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="HostOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.65)

[node name="Center" type="CenterContainer" parent="HostOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dialog" type="PanelContainer" parent="HostOverlay/Center"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_type_variation = &"Card"

[node name="Margin" type="MarginContainer" parent="HostOverlay/Center/Dialog"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="Form" type="VBoxContainer" parent="HostOverlay/Center/Dialog/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="DialogTitle" type="Label" parent="HostOverlay/Center/Dialog/Margin/Form"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.8, 0.45, 1)
theme_override_font_sizes/font_size = 32
text = "Host a room"

[node name="NameLabel" type="Label" parent="HostOverlay/Center/Dialog/Margin/Form"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.64, 0.74, 1)
theme_override_font_sizes/font_size = 16
text = "Room name"

[node name="RoomNameEdit" type="LineEdit" parent="HostOverlay/Center/Dialog/Margin/Form"]
unique_name_in_owner = true
layout_mode = 2
max_length = 32

[node name="PlayersLabel" type="Label" parent="HostOverlay/Center/Dialog/Margin/Form"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.64, 0.74, 1)
theme_override_font_sizes/font_size = 16
text = "Max players"

[node name="MaxPlayersSpin" type="SpinBox" parent="HostOverlay/Center/Dialog/Margin/Form"]
unique_name_in_owner = true
layout_mode = 2
min_value = 2.0
max_value = 8.0
value = 2.0
rounded = true

[node name="FormError" type="Label" parent="HostOverlay/Center/Dialog/Margin/Form"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.5, 0.45, 1)
theme_override_font_sizes/font_size = 16

[node name="Buttons" type="HBoxContainer" parent="HostOverlay/Center/Dialog/Margin/Form"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="CancelButton" type="Button" parent="HostOverlay/Center/Dialog/Margin/Form/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Cancel"

[node name="CreateButton" type="Button" parent="HostOverlay/Center/Dialog/Margin/Form/Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
text = "Create"
