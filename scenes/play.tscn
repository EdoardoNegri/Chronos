custom_minimum_size = Vector2(170, 0)
layout_mode = 2
size_flags_vertical = 3
tooltip_text = "Standard rooms use the official cards only. Custom cards rooms also allow the cards players created or imported."

[node name="PasswordField" type="VBoxContainer" parent="Content/Layout/Toolbar"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Label" type="Label" parent="Content/Layout/Toolbar/PasswordField"]
