text = "Host Room"

[node name="SearchField" type="VBoxContainer" parent="Content/Layout/Toolbar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Label" type="Label" parent="Content/Layout/Toolbar/SearchField"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
text = "Search"

[node name="SearchEdit" type="LineEdit" parent="Content/Layout/Toolbar/SearchField"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
tooltip_text = "Every word must be in the room's name or its host's name. Put text in quotes to match it exactly, spaces included."
placeholder_text = "Room name or host..."
clear_button_enabled = true

[node name="CardsField" type="VBoxContainer" parent="Content/Layout/Toolbar"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Label" type="Label" parent="Content/Layout/Toolbar/CardsField"]
layout_mode = 2
theme_type_variation = &"FieldLabel"
text = "Cards"

[node name="CardsOption" type="OptionButton" parent="Content/Layout/Toolbar/CardsField"]
